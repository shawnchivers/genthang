// Tang Nano 20K (GW2AR-18C) pins for Gen Thang with the TF card menu.
//
// The embedded SDRAM is bonded internally and connected through the "magic"
// top-level names (O_sdram_*, IO_sdram_dq); it must not appear here.

// 27MHz crystal
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// HDMI TX (only the _p net is located; _n is the paired pin)
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// On-board SPI flash (MSPI pins, used as GPIO after configuration)
IO_LOC "flash_spi_cs_n" 60;
IO_PORT "flash_spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "flash_spi_wp_n" 57;
IO_PORT "flash_spi_wp_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "flash_spi_hold_n" 63;
IO_PORT "flash_spi_hold_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "flash_spi_miso" 62;
IO_PORT "flash_spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "flash_spi_mosi" 61;
IO_PORT "flash_spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "flash_spi_clk" 59;
IO_PORT "flash_spi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// On-board TF card slot (SPI mode, same pins as SNESTang)
IO_LOC "sd_clk" 83;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sd_cmd" 82;
IO_PORT "sd_cmd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sd_dat0" 84;
IO_PORT "sd_dat0" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sd_dat1" 85;
IO_PORT "sd_dat1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sd_dat2" 80;
IO_PORT "sd_dat2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sd_dat3" 81;
IO_PORT "sd_dat3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// UART to the on-board BL616 (USB serial), 115200 8N1 firmware debug output
IO_LOC "UART_RXD" 70;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "UART_TXD" 69;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Status LEDs (active low)
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// GT_PAD=raw: handheld pinout, 12 direct buttons to GND (internal pull-ups).
// Laid out for a Nano mounted component side forward, USB-C up:
//   J6 (left, D-pad and jack side): D-pad on J6.8-11 in a row, jack on J6.12-14, GND J6.20
//   J5 (right, face-button side):  X/A J5.5-6, Y/B J5.10/12, Z/C J5.17-18,
//                                  Start J5.3, Mode J5.13, GND J5.15
// Pins with on-board functions are avoided (51/54-56 speaker amp, 79 LED strip, 52/53 EDID,
// 15-20 LEDs, 80/85 TF card). Spare: 73, 74, 75, 77 (J6.1, J6.2, J6.3, J6.5).
// btn_n[0..11] Genesis functions: B, A, Mode, Start, Up, Down, Left, Right, C, Y, X, Z.
IO_LOC "btn_n[0]" 49;  // B, J5.12
IO_PORT "btn_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[1]" 41;  // A, J5.6
IO_PORT "btn_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[2]" 86;  // Mode, J5.13
IO_PORT "btn_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[3]" 76;  // Start, J5.3
IO_PORT "btn_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[4]" 27;  // Up, J6.8
IO_PORT "btn_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[5]" 28;  // Down, J6.9
IO_PORT "btn_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[6]" 25;  // Left, J6.10
IO_PORT "btn_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[7]" 26;  // Right, J6.11
IO_PORT "btn_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[8]" 71;  // C, J5.18
IO_PORT "btn_n[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[9]" 48;  // Y, J5.10
IO_PORT "btn_n[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[10]" 42;  // X, J5.5
IO_PORT "btn_n[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n[11]" 72;  // Z, J5.17
IO_PORT "btn_n[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 3.5 mm jack (1-bit line-out, RC filter off board), three pins in a row: L J6.14, R J6.13,
// headphone detect J6.12 (jack's RING-NORMAL contact; reads high with a plug in)
IO_LOC "audio_jack_l" 31;
IO_PORT "audio_jack_l" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "audio_jack_r" 30;
IO_PORT "audio_jack_r" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hp_det" 29;
IO_PORT "hp_det" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// On-board MAX98357A speaker amplifier (fixed board traces), speaker on its 2-pin pads
IO_LOC "i2s_bclk" 56;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_lrck" 55;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_din" 54;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "spk_en" 51;
IO_PORT "spk_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
